// air_matmul.comp — Vulkan compute shader: SGEMM  out[M×N] = A[M×K] × B[K×N]
//
// Tiled 16×16 blocked GEMM exploiting shared memory for bandwidth reduction.
// Dispatched as: vkCmdDispatch(ceil(N/16), ceil(M/16), 1)
// Push constants: M, N, K (u32 each)
// Binding 0: A (readonly float[M*K])
// Binding 1: B (readonly float[K*N])
// Binding 2: C (writeonly float[M*N])

#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PushConstants {
    uint M;
    uint N;
    uint K;
} pc;

layout(set = 0, binding = 0) readonly  buffer ABuf { float A[]; };
layout(set = 0, binding = 1) readonly  buffer BBuf { float B[]; };
layout(set = 0, binding = 2) writeonly buffer CBuf { float C[]; };

// 16×16 tiles — fits in 2 KB shared memory (within the 32 KB Vulkan minimum)
shared float tileA[16][16];
shared float tileB[16][16];

void main() {
    uint row = gl_WorkGroupID.y * 16u + gl_LocalInvocationID.y;
    uint col = gl_WorkGroupID.x * 16u + gl_LocalInvocationID.x;
    uint ly  = gl_LocalInvocationID.y;
    uint lx  = gl_LocalInvocationID.x;

    float acc = 0.0;

    uint n_tiles = (pc.K + 15u) / 16u;
    for (uint t = 0u; t < n_tiles; t++) {
        uint aCol = t * 16u + lx;
        uint bRow = t * 16u + ly;

        tileA[ly][lx] = (row < pc.M && aCol < pc.K) ? A[row * pc.K + aCol] : 0.0;
        tileB[ly][lx] = (bRow < pc.K && col < pc.N) ? B[bRow * pc.N + col] : 0.0;
        barrier();

        for (uint ki = 0u; ki < 16u; ki++)
            acc += tileA[ly][ki] * tileB[ki][lx];
        barrier();
    }

    if (row < pc.M && col < pc.N)
        C[row * pc.N + col] = acc;
}
