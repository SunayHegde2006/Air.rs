# ============================================================
# Air.rs v2.0.0 — .gitignore
# ============================================================

# ── Rust build artifacts ────────────────────────────────────
/target/
**/*.rs.bk

# ── Precompiled kernel binaries ─────────────────────────────
# Platform-specific build artifacts generated by:
#   python3 scripts/build_kernels.py
#   .github/workflows/kernels.yml
# Source kernels in kernels/src/ ARE tracked.
# These compiled outputs are NOT tracked.
kernels/precompiled/*.fatbin
kernels/precompiled/*.hsaco
kernels/precompiled/*.metallib
kernels/precompiled/*.cubin
kernels/precompiled/*.ptx
kernels/precompiled/*.so
kernels/precompiled/*.dll
kernels/precompiled/*.dylib
kernels/precompiled/*.wgsl
kernels/precompiled/*.o
kernels/precompiled/*.a

# ── Profiling and benchmark output ──────────────────────────
# Machine-specific. Regenerated per profiling session.
profiles/
kernel_profile.json
*.ncu-rep
*.nsys-rep
*.qdrep
*.qdstrm
*.profraw
*.gcda
*.gcno

# ── Analysis tool output ────────────────────────────────────
graphify-out/
.graphifyignore

# ── Scratch and temporary files ─────────────────────────────
# DO NOT use blanket *.md rule — it ignores CHANGELOG.md, GATES.md, docs/
# Only ignore specific scratch files:
13.md
14.md
15.md
*.tmp
*.scratch
*.bak
*.swp
*.swo
*~

# ── Python artifacts (air-python crate) ─────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/
.ipynb_checkpoints/
.python-version
*.abi3.so
.venv/
uv.lock
.pytest_cache/

# ── IDE and editor files ────────────────────────────────────
.idea/
.vscode/
.claw/
*.log

# ── OS files ────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier

# ── Environment and secrets ─────────────────────────────────
.env
.env.*
!.env.example

# ── GGUF model files (too large for git) ────────────────────
*.gguf

# ── Test artifacts ──────────────────────────────────────────
/test_models/
/results/
/benchmarks/

# ── Cargo.lock (TRACK for binary workspaces) ────────────────
# Cargo.lock IS tracked because this workspace produces binaries.
# Do NOT add Cargo.lock to .gitignore.